{
	"name": "sf-tennis-cli",
	"version": "1.2.0",
	"description": "Find available tennis court times near you in SF",
	"type": "module",
	"bin": {
		"tennis": "./cli.ts"
	},
	"scripts": {
		"start": "bun cli.ts",
		"notify": "bun notify.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "knip",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"knip": {
		"ignoreDependencies": [
			"bun-types"
		],
		"ignoreExportsUsedInFile": true
	},
	"dependencies": {
		"chalk": "^5.3.0",
		"commander": "^12.1.0",
		"dayjs": "^1.11.20"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@types/bun": "^1.3.11",
		"knip": "^6.1.0",
		"lefthook": "^2.1.4",
		"typescript": "^6.0.2"
	}
}
